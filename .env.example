

# Railway gives postgres://... ; Settings rewrites it to the installed driver
DATABASE_URL=postgresql://user:password@localhost:5432/log_book

# Throwaway database for pytest. It is DROPPED and rebuilt on every run.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/log_book_test

# python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars)
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
# Production serves the UI and API from one origin, so this is mostly for local dev.
CORS_ORIGINS=http://localhost:5173

# A different random value. Changing it later invalidates ALL stored PINs.
PIN_PEPPER=

# Browser push for admins. Leave unset to run without it.
# python -m scripts.vapid_keys   prints all three lines. VAPID_SUBJECT must be a mailto: you read.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional overrides (defaults shown)
# LEFT_INSIDE_HOURS=12
# LEFT_INSIDE_CHECK_MINUTES=10   (0 turns every server check off)
# QUEUED_WARN_HOURS=6            (a truck waiting in the queue this long; 0 = off)
# DUTY_WARN_HOURS=14             (an officer on duty this long; 0 = off)
# GATE_UNMANNED_MINUTES=15       (a manned gate left empty this long; 0 = off)
# JWT_ISSUER=log-book
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# MAX_PIN_ATTEMPTS=5
# LOCKOUT_MINUTES=15
